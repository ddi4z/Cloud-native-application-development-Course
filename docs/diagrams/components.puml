@startuml components

skinparam actorStyle awesome

skinparam hexagon {
  BackgroundColor #FF000022
  BorderColor red
  FontColor black
}

skinparam database {
  BackgroundColor #1E90FF
  BorderColor black
  FontColor white
}

title "Vista Funcional Componentes"

actor User

frame "env" {
  hexagon "\nusers_app\n" as users_app
  hexagon "\nposts_app\n" as posts_app
  hexagon "\noffers_app\n" as offers_app
  hexagon "\nroutes_app\n" as routes_app

  database "\nusers_db\n" as users_db
  database "\nposts_db\n" as posts_db
  database "\noffers_db\n" as offers_db
  database "\nroutes_db\n" as routes_db

  User ..> users_app
  User ..> posts_app
  User ..> offers_app
  User ..> routes_app

  users_app --> users_db
  posts_app --> posts_db
  offers_app --> offers_db
  routes_app --> routes_db
}
