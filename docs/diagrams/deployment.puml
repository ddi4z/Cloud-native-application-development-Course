@startuml deployment

skinparam actorStyle awesome

skinparam database {
  BackgroundColor #238be6
  BorderColor black
  FontColor white
}

skinparam component<<Service>> {
  BackgroundColor #63a1d6
  BorderColor blue
  FontColor white
}

skinparam component {
  BackgroundColor #b1f2bc
}

title "Vista de despliegue local"

actor User

frame "k8s" as "KubernetesCluster" {
  ' Users app
  component "users-app-service" as users_app_service <<Service>>

  frame "users-app" as users-app {
    frame "docker" {
      component "users_app" as users_app
    }
  }

  component "users-db-service" as users_db_service <<Service>>
  frame "users-db" as PodDbUsers {
    frame "docker" as DockerDbUsers {
      database "users_db" as users_db
    }
  }
  artifact "users-db-volumen" as users_db_volumen

  users_app_service --> users_app
  users_app --> users_db_service
  users_db_service --> users_db
  users_db --> users_db_volumen

  ' Posts app
  component "posts-app-service" as posts_app_service <<Service>>

  frame "posts-app" as posts-app {
    frame "docker" as DockerPosts {
      component "posts_app" as posts_app
    }
  }

  component "posts-db-service" as posts_db_service <<Service>>

  frame "posts-db" as PodDbPosts {
    frame "docker" as DockerDbPosts {
      database "posts_db" as posts_db
    }
  }
  artifact "posts-db-volumen" as posts_db_volumen

  posts_app_service --> posts_app
  posts_app --> posts_db_service
  posts_db_service --> posts_db
  posts_db --> posts_db_volumen

  ' Routes app
  component "routes-app-service" as routes_app_service <<Service>>

  frame "routes-app" as routes-app {
    frame "docker" as DockerRoutes {
      component "routes_app" as routes_app
    }
  }

  component "routes-db-service" as routes_db_service <<Service>>

  frame "routes-db" as PodDbRoutes {
    frame "docker" as DockerDbRoutes {
      database "routes_db" as routes_db
    }
  }
  artifact "routes-db-volumen" as routes_db_volumen
  
  routes_app_service --> routes_app
  routes_app --> routes_db_service
  routes_db_service --> routes_db
  routes_db --> routes_db_volumen

  ' Offers app
  component "offers-app-service" as offers_app_service <<Service>>

  frame "offers-app" as offers-app {
    frame "docker" as DockerOffers {
      component "offers_app" as offers_app
    }
  }
  component "offers-db-service" as offers_db_service <<Service>>

  frame "offers-db" as PodDbOffers {
    frame "docker" as DockerDbOffers {
      database "offers_db" as offers_db
    }
  }
  artifact "offers-db-volumen" as offers_db_volumen 

  offers_app_service --> offers_app
  offers_app --> offers_db_service
  offers_db_service --> offers_db
  offers_db --> offers_db_volumen
}

User ..> users_app_service: HTTP
User ..> posts_app_service: HTTP
User ..> offers_app_service: HTTP
User ..> routes_app_service: HTTP

@enduml