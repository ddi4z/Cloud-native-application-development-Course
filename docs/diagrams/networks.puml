@startuml
!theme plain

skinparam title {
    FontSize 20
    FontColor #333333
}
skinparam cloud {
    BackgroundColor #f0f0f0
    BorderColor gray
}
skinparam frame {
    BorderColor #000000
    BackgroundColor #ffffff
    TitleFontColor #000000
}
skinparam package {
    BackgroundColor #e6ffed
    BorderColor #4CAF50
    BorderThickness 2
    FontColor #333333
}
skinparam component {
    BackgroundColor #b1f2bc
    BorderColor #4CAF50
    FontColor #000000
}
skinparam component<<Service>> {
    BackgroundColor #63a1d6
    BorderColor #0000FF
    FontColor white
}
skinparam component<<Database>> {
    BackgroundColor #238be6
    BorderColor black
    FontColor white
}
skinparam interface {
    BackgroundColor #82b3e8
    BorderColor #0000FF
    FontColor black
}

title "Vista de Despliegue en Kubernetes (Alineado con Ingress, ECR y RDS)"

cloud Internet

frame "K8s" {

    ' ---------------- Ingress único ----------------
    component "Ingress (Nginx/ALB)" as ingress <<Service>>
    note right of ingress
      Entrada HTTP(S)
      Reglas (ej.):
      - POST /posts           -> rf003-app-service
      - GET  /posts/{id}/details -> rf004-app-service
      - POST /offers          -> rf005-app-service
    end note

    ' ---------------- Redes / Paquetes de dominio (sin cambios de ms/puertos) ----------------
    package "users-network" as users_network {
        component "users-app-service" as users_app_service <<Service>>
        note right of users_app_service
          Port: 80
        end note

        frame "users-app" as users_app_frame {
            frame "pod" as users_app_pod {
                component "users_app" as users_app
                note right of users_app
                  Port: 9000
                end note
            }
        }
    }

    package "posts-network" as posts_network {
        component "posts-app-service" as posts_app_service <<Service>>
        note right of posts_app_service
          Port: 80
        end note

        frame "posts-app" as posts_app_frame {
            frame "pod" as posts_app_pod {
                component "posts_app" as posts_app
                note right of posts_app
                  Port: 9000
                end note
            }
        }
    }

    package "routes-network" as routes_network {
        component "routes-app-service" as routes_app_service <<Service>>
        note right of routes_app_service
          Port: 80
        end note

        frame "routes-app" as routes_app_frame {
            frame "pod" as routes_app_pod {
                component "routes_app" as routes_app
                note right of routes_app
                  Port: 8000
                end note
            }
        }
    }

    package "offers-network" as offers_network {
        component "offers-app-service" as offers_app_service <<Service>>
        note right of offers_app_service
          Port: 80
        end note

        frame "offers-app" as offers_app_frame {
            frame "pod" as offers_app_pod {
                component "offers_app" as offers_app
                note right of offers_app
                  Port: 3003
                end note
            }
        }
    }

    ' ---------------- Nuevo servicio de dominio: scores ----------------
    package "scores-network" as scores_network {
        component "scores-app-service" as scores_app_service <<Service>>
        note right of scores_app_service
          Port: 80
        end note

        frame "scores-app" as scores_app_frame {
            frame "pod" as scores_app_pod {
                component "scores_app" as scores_app
                note right of scores_app
                  Port: 9000
                end note
            }
        }
    }

    ' ---------------- Capa RF (APIs expuestas al usuario vía Ingress) ----------------
    package "rf003-network" as rf003_network {
        component "rf003-app-service" as rf003_app_service <<Service>>
        note right of rf003_app_service
          Port: 80
        end note
        frame "rf003-app" as rf003_app_frame {
            frame "pod" as rf003_app_pod {
                component "rf003_app" as rf003_app
                note right of rf003_app
                  Port: xxxx
                end note
            }
        }
    }

    package "rf004-network" as rf004_network {
        component "rf004-app-service" as rf004_app_service <<Service>>
        note right of rf004_app_service
          Port: 80
        end note
        frame "rf004-app" as rf004_app_frame {
            frame "pod" as rf004_app_pod {
                component "rf004_app" as rf004_app
                note right of rf004_app
                  Port: 9000
                end note
            }
        }
    }

    package "rf005-network" as rf005_network {
        component "rf005-app-service" as rf005_app_service <<Service>>
        note right of rf005_app_service
          Port: 80
        end note
        frame "rf005-app" as rf005_app_frame {
            frame "pod" as rf005_app_pod {
                component "rf005_app" as rf005_app
                note right of rf005_app
                  Port: xxxx
                end note
            }
        }
    }

    ' ---------------- Base de datos única en la nube (RDS) ----------------
    frame "platform-db (AWS RDS)" as platform_db_frame {
        component "platform_db" as platform_db <<Database>>
        note right of platform_db
          Port: 5432
          Única BD con tablas por dominio:
          users.*, routes.*, posts.*, offers.*, scores.*
        end note
    }

    ' ---------------- Registry de contenedores (ECR) ----------------
    component "Amazon ECR\n(Container Registry)" as ecr <<Service>>
    note right of ecr
      Pull de imágenes para Pods
    end note

    ' ---------------- Conexiones internas (RF → dominios) ----------------
    rf003_app --> users_app_service
    rf003_app --> routes_app_service
    rf003_app --> posts_app_service

    rf004_app --> users_app_service
    rf004_app --> posts_app_service
    rf004_app --> offers_app_service
    rf004_app --> routes_app_service
    rf004_app --> scores_app_service

    rf005_app --> users_app_service
    rf005_app --> posts_app_service
    rf005_app --> offers_app_service
    rf005_app --> scores_app_service

    ' ---------------- Acceso a BD única ----------------
    users_app  --> platform_db
    posts_app  --> platform_db
    routes_app --> platform_db
    offers_app --> platform_db
    scores_app --> platform_db

    ' ---------------- Pull de imágenes desde ECR (dotted) ----------------
    users_app  ..> ecr : pull image
    posts_app  ..> ecr : pull image
    routes_app ..> ecr : pull image
    offers_app ..> ecr : pull image
    scores_app ..> ecr : pull image
    rf003_app  ..> ecr : pull image
    rf004_app  ..> ecr : pull image
    rf005_app  ..> ecr : pull image

    ' ---------------- Ingress routing ----------------
    Internet ..> ingress
    ingress --> rf003_app_service
    ingress --> rf004_app_service
    ingress --> rf005_app_service
}

@enduml
